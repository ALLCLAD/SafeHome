# ===================================================================
# CONFIGURATION SERVEUR & RESEAU
# ===================================================================
SERVER_PORT=8080#(si le port refuse switcher de port)
CORS_ALLOWED_ORIGINS=http://localhost:8080#(changer ici aussi)

# ===================================================================
# BASE DE DONNEES POSTGRESQL (NEON DB)
# ===================================================================
DB_URL=jdbc:postgresql://<neon-endpoint>.neon.tech/neondb?sslmode=require
DB_USERNAME=<votre_nom_utilisateur>
DB_PASSWORD=<votre_mot_de_passe>

# ===================================================================
# SECURITE & AUTHENTIFICATION (JWT)
# Cle secrete d'au moins 256 bits pour la signature des tokens
# ===================================================================
JWT_SECRET=remplacez_par_votre_cle_secrete_longue_et_aleatoire
JWT_EXPIRATION_MS=86400000

# ===================================================================
# BROKER IOT TEMPS REEL (MQTT - HIVEMQ)
# ===================================================================
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_CLIENT_ID=safehome_backend_charo_2026
MQTT_TOPIC_PREFIX=safehome_charo_x789
