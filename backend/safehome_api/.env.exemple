# --- Base de données PostgreSQL (Neon DB) ---
# Remplacez par l'URL de connexion fournie par Neon
DB_URL=jdbc:postgresql://<votre-endpoint>.neon.tech/safehome_db?sslmode=require
DB_USERNAME=<votre-nom-dutilisateur>
DB_PASSWORD=<votre-mot-de-passe>

# --- Sécurité & JWT ---
# Générez une longue chaîne aléatoire sécurisée pour signer vos tokens
JWT_SECRET=mettez_ici_une_cle_secrete_aleatoire_assez_longue

# --- Broker MQTT ---
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_CLIENT_ID=safehome_backend_server